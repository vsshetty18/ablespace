# PostgreSQL connection string (Supabase/Neon) — used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@host:5432/ablespace?schema=public"

# Port the NestJS server listens on (Render sets this automatically in prod)
PORT=3001

# Comma-separated list of allowed frontend origins for CORS
# e.g. http://localhost:3000,https://ablespace-frontend.vercel.app
CORS_ORIGIN="http://localhost:3000"

# Secret used to sign the guest session token (any long random string)
GUEST_SESSION_SECRET="replace-with-a-long-random-string"
